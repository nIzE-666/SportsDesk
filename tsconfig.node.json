{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "dev/**/*.ts",
    "scripts/**/*.ts",
    "src/lib/pitchDateCache.ts",
    "src/lib/sportsIdentity.ts",
    "src/features/offline/offlineModel.ts",
    "src/features/football/types.ts"
  ]
}
