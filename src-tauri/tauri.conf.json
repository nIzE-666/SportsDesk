{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SportsDesk",
  "version": "2.0.0",
  "identifier": "com.world.sportsdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SportsDesk",
        "label": "main",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0b101c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; media-src 'self' https: blob:; connect-src 'self' https: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Sports",
    "shortDescription": "SportsDesk personal hub",
    "longDescription": "Personal desktop app for football analytics, Formula 1 and live TV.",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDOEZFNkFBNTAyQzUzQjgKUldTNFV5eFFxdWFQakk1TklaTThPREx3UWx2UTBSdk5meTNrWkdmb3llYTM1cXBsTWZpNUtrMkIK",
      "endpoints": []
    }
  }
}
